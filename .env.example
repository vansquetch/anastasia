TICKETMASTER_API_KEY=
TELEGRAM_BOT_TOKEN=
# Username del bot (sin @), tal como aparece en su link t.me/<username> —
# lo necesita el deep link "Suscribirme por Telegram" del frontend.
TELEGRAM_BOT_USERNAME=
DATABASE_PATH=./data/event-watcher.sqlite

# API HTTP para el frontend
API_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Celulares habilitados para usar la app, separados por coma (con o sin +57).
# Vacío = cualquiera puede registrarse. Para probar, usar los mismos números
# de la lista de destinatarios de prueba de WhatsApp.
ALLOWED_PHONES=

# Lista de eventos vigilados (Ticketmaster + Crowder), con su info de
# display — ver config/watched-events.json. Solo cambiar esta ruta si
# querés usar un archivo distinto.
WATCHED_EVENTS_FILE=./config/watched-events.json

# Scheduler
POLLING_INTERVAL_SECONDS=15
# Log de auditoría de los schedulers: una línea por tick (latido) y una por
# cada evento revisado (estado anterior -> nuevo, notificaciones, errores).
# Rota a <archivo>.1 al pasar 5 MB.
SCHEDULER_LOG_FILE=./data/scheduler.log

# Rate limiting / reintentos contra la Discovery API de Ticketmaster
# (ajustable sin tocar código; valores por defecto pensados para el tier gratuito)
TICKETMASTER_MAX_REQUESTS_PER_SECOND=5
TICKETMASTER_REQUEST_TIMEOUT_MS=8000
TICKETMASTER_RETRY_MAX_ATTEMPTS=3
TICKETMASTER_RETRY_BASE_DELAY_MS=500

# Reservado para fase futura, no usado aún:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Proveedor secundario Crowder: parámetros globales (qué páginas/ítems
# vigilar, con sus fechas de ventana activa, vive en watched-events.json;
# ver scripts/validate-crowder-scrape.ts para listar los slugs disponibles
# en una página)
CROWDER_POLLING_INTERVAL_SECONDS=60
CROWDER_PAGE_CACHE_TTL_SECONDS=60

# Notificador WhatsApp (Cloud API de Meta) — opcional, si falta cualquiera
# de las 3 el canal WHATSAPP queda sin registrar (ver container.ts).
# El mensaje se manda como plantilla aprobada en Meta Business Manager, no
# como texto libre (ver scripts/validate-whatsapp-send.ts).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=v20.0
# Se antepone a los celulares locales de 10 dígitos al enviar (la API lo exige).
WHATSAPP_DEFAULT_COUNTRY_CODE=57
# Webhook de WhatsApp (GET/POST /api/webhooks/whatsapp) — opcional, si falta
# cualquiera de las 2 la ruta responde 404. VERIFY_TOKEN es un string que
# inventás vos y pegás en "Identificador de verificación" del panel de Meta;
# APP_SECRET está en Configuración de la app → Básica → Clave secreta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Notificador email (Brevo) — opcional, si falta API_KEY o SENDER_EMAIL el
# canal EMAIL queda sin registrar. SENDER_EMAIL tiene que ser un remitente
# verificado en Brevo → Senders & IPs (ver scripts/validate-brevo-send.ts).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Event Watcher
